{
  "name": "baretext",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@better-auth/passkey": "^1.7.7",
      "@electric-sql/client": "^1.5.28",
      "@t3-oss/env-core": "^0.13.11",
      "@types/bun": "^1.4.2",
      "better-auth": "^1.7.7",
      "drizzle-orm": "^1.0.0-rc.5-5935859",
      "typescript": "^7.0.2",
      "zod": "^4.6.2"
    }
  },
  "scripts": {
    "build": "bun --filter '*' --parallel build",
    "dev:web": "bun --filter @baretext/web dev",
    "dev:api": "bun --filter @baretext/api dev",
    "build:web": "bun --filter @baretext/web build",
    "build:api": "bun --filter @baretext/api build",
    "start:api": "bun --filter @baretext/api start",
    "start:web": "bun --filter @baretext/web start",
    "check": "biome check",
    "check:write": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "lefthook": "^2.1.12"
  }
}
