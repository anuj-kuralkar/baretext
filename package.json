{
  "name": "baretext",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*",
      "tests"
    ],
    "catalog": {
      "@better-auth/passkey": "^1.7.15",
      "@electric-sql/client": "^1.5.28",
      "@neon/realtime": "^0.2.1",
      "@neon/realtime-drizzle": "^0.2.0",
      "@playwright/test": "^1.65.0",
      "@t3-oss/env-core": "^0.13.11",
      "@types/bun": "^1.4.4",
      "@vitest/coverage-v8": "5.1.2",
      "better-auth": "^1.7.15",
      "drizzle-orm": "1.0.0-rc.5",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "typescript": "^7.0.2",
      "vitest": "5.1.2",
      "zod": "^4.6.7"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun --filter '*' --parallel build",
    "check": "bun --filter '*' --parallel check",
    "fmt": "biome format --write --reporter=concise .",
    "fmt:check": "biome format --reporter=concise .",
    "lint": "biome lint --reporter=concise .",
    "lint:fix": "biome lint --write --reporter=concise .",
    "test": "bun run test:unit",
    "test:unit": "vitest run --project '*-unit'",
    "test:coverage": "vitest run --project '*-unit' --coverage",
    "test:e2e": "bun --filter @baretext/e2e test",
    "test:all": "bun run test:unit && bun run test:e2e",
    "dev:web": "bun --filter @baretext/web dev",
    "dev:api": "bun --filter @baretext/api dev",
    "build:web": "bun --filter @baretext/web build",
    "build:api": "bun --filter @baretext/api build",
    "start:api": "bun --filter @baretext/api start",
    "start:web": "bun --filter @baretext/web start"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@vitest/coverage-v8": "catalog:",
    "lefthook": "^2.2.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
