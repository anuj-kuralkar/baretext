{
  "name": "baretext",
  "version": "0.0.1",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "@better-auth/passkey": "^1.7.15",
      "@electric-sql/client": "^1.5.28",
      "@neon/realtime": "^0.2.1",
      "@neon/realtime-drizzle": "^0.2.0",
      "@t3-oss/env-core": "^0.13.11",
      "@types/bun": "^1.4.4",
      "better-auth": "^1.7.15",
      "drizzle-orm": "1.0.0-rc.5",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "typescript": "^7.0.2",
      "vitest": "^5.1.0",
      "zod": "^4.6.7"
    }
  },
  "type": "module",
  "scripts": {
    "build": "bun --filter '*' --parallel build",
    "test": "bun run test:unit",
    "test:all": "bun run test:unit && bun run test:browser",
    "test:unit": "vitest run --project=emails-unit --project=web-unit",
    "test:browser": "vitest run --project=web-browser --browser.headless --passWithNoTests",
    "test:browser:ui": "vitest --project=web-browser --browser.headless=false --passWithNoTests",
    "dev:web": "bun --filter @baretext/web dev",
    "dev:api": "bun --filter @baretext/api dev",
    "build:web": "bun --filter @baretext/web build",
    "build:api": "bun --filter @baretext/api build",
    "start:api": "bun --filter @baretext/api start",
    "start:web": "bun --filter @baretext/web start",
    "check": "biome check",
    "check:write": "biome check --write"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "lefthook": "^2.2.2",
    "vitest": "catalog:"
  },
  "packageManager": "bun@1.4.2"
}
