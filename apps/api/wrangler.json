{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "baretext",
  "main": "./src/index.ts",
  "compatibility_date": "2026-09-01",
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
