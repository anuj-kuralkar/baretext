{
  "name": "@baretext/api",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --compile --minify-whitespace --minify-syntax --target bun --outfile server src/index.ts",
    "start": "./server",
    "check": "biome check",
    "check:write": "biome check --write",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@baretext/auth": "workspace:*",
    "@baretext/db": "workspace:*",
    "@electric-sql/client": "catalog:",
    "@elysia/cors": "2.0.0-beta.1",
    "@t3-oss/env-core": "catalog:",
    "drizzle-orm": "catalog:",
    "elysia": "2.0.0-beta.12",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:",
    "wrangler": "^4.128.0"
  }
}
