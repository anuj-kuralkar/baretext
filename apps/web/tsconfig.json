{
  "compilerOptions": {
    // Some default flags (required by Next.js)
    "strict": true,
    "module": "esnext",

    "lib": ["esnext", "dom"],
    "target": "esnext",
    "jsx": "react-jsx",
    "allowJs": true,
    "types": ["bun", "react", "react-dom"],

    "moduleResolution": "bundler",
    "noEmit": true,

    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": ["node_modules"]
}
